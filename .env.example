# Identificação recomendada para serviços bibliográficos
PUBMED_EMAIL=seu_email@exemplo.com
NCBI_API_KEY=
CROSSREF_EMAIL=seu_email@exemplo.com

# Descoberta multi-fonte
DISCOVERY_QUERY=multiple sclerosis
PUBMED_DISCOVERY_ENABLED=true
CROSSREF_DISCOVERY_ENABLED=true
EUROPE_PMC_DISCOVERY_ENABLED=true

# Limites por fonte
PUBMED_RETMAX=250
PUBMED_BATCH_SIZE=150
CROSSREF_RETMAX=250
EUROPE_PMC_RETMAX=250

# Crossref: também procura registros recém-depositados no intervalo,
# além da janela de data de publicação.
CROSSREF_DISCOVERY_INCLUDE_CREATED=true

# Especificidade para esclerose múltipla
# O Radar avalia título, abstract, MeSH, keywords e outros metadados.
# "MS" isolado não conta como evidência, para reduzir falsos positivos.
MS_ELIGIBILITY_ENABLED=true
MS_HIGH_THRESHOLD=9
MS_MODERATE_THRESHOLD=6
MS_STORE_PENDING=true
MS_REASSESS_ON_STARTUP=true

# Janelas
LOOKBACK_DAYS=45
DEFAULT_VIEW_DAYS=5

# Enriquecimento estruturado
ENRICHMENT_ENABLED=true
CROSSREF_ENABLED=true
EUROPE_PMC_ENABLED=true

# Enriquecimento HTML com BeautifulSoup
# Desativado por padrão porque páginas de editoras variam e podem bloquear automação.
PUBLISHER_HTML_ENABLED=false
ENRICHMENT_MAX_ARTICLES=50
ENRICHMENT_TIMEOUT=20
ENRICHMENT_PAUSE_SECONDS=0.15
HTML_MAX_BYTES=2000000

# Aplicação
SECRET_KEY=troque-esta-chave
HOST=127.0.0.1
PORT=5050
DEBUG=false
