# Identificação recomendada pelo NCBI
PUBMED_EMAIL=seu_email@exemplo.com
NCBI_API_KEY=

# Coleta no PubMed
LOOKBACK_DAYS=45
PUBMED_RETMAX=250
PUBMED_BATCH_SIZE=150

# Visualização do painel
# O painel abre, por padrão, mostrando os últimos 5 dias.
DEFAULT_VIEW_DAYS=5

# Aplicação
SECRET_KEY=troque-esta-chave
HOST=127.0.0.1
PORT=5000
DEBUG=false
